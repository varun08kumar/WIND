# Copy to .env and adjust. No secrets are required: the Elexon BMRS API is public.

# Docker Compose database credentials (local development only).
POSTGRES_USER=reint
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=reint

# Used when running the backend outside Docker. Compose and Heroku set DATABASE_URL themselves.
DATABASE_URL=postgresql+psycopg://reint:change-me-locally@localhost:5432/reint

# Decision-time rule: forecasts for delivery day D must be published at or before
# DECISION_CUTOFF_LOCAL_TIME on day D - DECISION_DAYS_BEFORE, in MARKET_TIMEZONE.
DECISION_CUTOFF_LOCAL_TIME=09:00
DECISION_DAYS_BEFORE=1
MARKET_TIMEZONE=Europe/London

# Delivery dates covered (UK local).
DATA_START_DATE=2026-01-01
DATA_END_DATE=2026-01-31
# Live mode: the range ends at tomorrow (the day being bought) instead of DATA_END_DATE.
# Keep data current with: python -m scripts.ingest_live --loop
LIVE_MODE=false

# Elexon API client.
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
ELEXON_TIMEOUT_SECONDS=60
ELEXON_MAX_RETRIES=4
ELEXON_WINDOW_DAYS=7

# Comma-separated browser origins allowed to call the API directly (dev servers).
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
